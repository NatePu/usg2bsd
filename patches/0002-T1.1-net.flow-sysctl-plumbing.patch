+#define FLOWCTL_MODE		1	/* 0 off, 1 mbuf, 2 zero-copy, 3 shadow */
+#define FLOWCTL_MAX		2	/* table limit; changes in mode 0 only */
+#define FLOWCTL_IDLE		3	/* seconds without a hit before GC */
+#define FLOWCTL_BUDGET		4	/* RX work per interrupt, modes 1-3 */
+#define FLOWCTL_YIELD		5	/* RX hold-off after the budget, usec */
+#define FLOWCTL_DEBUG		6	/* log refusals and invalidations */
+#define FLOWCTL_MAXID		7
+
+#define FLOWCTL_NAMES { \
+	{ 0, 0 }, \
+	{ "mode", CTLTYPE_INT }, \
+	{ "max", CTLTYPE_INT }, \
+	{ "idle", CTLTYPE_INT }, \
+	{ "budget", CTLTYPE_INT }, \
+	{ "yield", CTLTYPE_INT }, \
+	{ "debug", CTLTYPE_INT }, \
+}
+
 #ifdef _KERNEL
 
 #ifndef NFLOW
