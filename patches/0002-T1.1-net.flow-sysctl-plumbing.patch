 	return (3);
 }
 
+/* handle net.flow requests */
+int
+sysctl_flow(char *string, char **bufpp, int mib[], int flags, int *typep)
+{
+	int indx;
+
+	if (*bufpp == NULL) {
+		listall(string, &flowlist);
+		return (-1);
+	}
+	if ((indx = findname(string, "third", bufpp, &flowlist)) == -1)
+		return (-1);
+	mib[2] = indx;
+	*typep = flowlist.list[indx].ctl_type;
+	return (3);
+}
+
