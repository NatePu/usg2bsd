+
+/*
+ * Flow table.  Readers (the MD hit path, the amd64 test hook) look up under
+ * SMR without a lock; writers hold flow_mtx.  Only the single flow_tq
+ * worker inserts and reaps, and the mode setter flushes only after waiting
+ * for that worker (DESIGN 5.8).
+ */
+
+static inline struct flow_bucket *
+flow_bucket(const struct flow_key *key)
+{
+	uint64_t h;
+
+	h = SipHash24(&flow_hashkey, key, sizeof(*key));
+	return (&flow_tbl[h & (FLOW_NBUCKETS - 1)]);
+}
+
+static inline int
+flow_key_eq(const struct flow_key *a, const struct flow_key *b)
+{
+	return (a->fk_src == b->fk_src && a->fk_dst == b->fk_dst &&
+	    a->fk_port == b->fk_port && a->fk_vid == b->fk_vid);
+}
+
+/*
+ * Find the entry for key, dead or alive; the caller checks FLOW_DEAD and
+ * f_gen.  The caller is inside an SMR read section and must not touch the
+ * result after leaving it.
+ */
+struct flow *
+flow_lookup(const struct flow_key *key)
+{
+	struct flow *f;
+
+	SMR_ASSERT_CRITICAL();
+	SMR_LIST_FOREACH(f, flow_bucket(key), f_hash) {
+		if (flow_key_eq(&f->f_key, key))
+			return (f);
+	}
+	return (NULL);
+}
+
+/*
+ * Link f, a fully initialised flow with f_gen set, unless a live entry
+ * with the same key and generation is already linked.  A dead or stale
+ * entry with the same key is unlinked first, so it never blocks
+ * relearning until the next GC (DESIGN 5.3 step 7).  The caller holds
+ * flow_mtx and, on any result but FLOW_ADD_OK, still owns f.
+ */
+int
+flow_table_add(struct flow *f)
+{
+	struct flow_bucket *b = flow_bucket(&f->f_key);
+	struct flow *of;
+
+	MUTEX_ASSERT_LOCKED(&flow_mtx);
+
+	SMR_LIST_FOREACH_LOCKED(of, b, f_hash) {
+		if (flow_key_eq(&of->f_key, &f->f_key))
+			break;
+	}
+	if (of != NULL) {
+		if (!ISSET(atomic_load_int(&of->f_flags), FLOW_DEAD) &&
+		    of->f_gen == f->f_gen)
+			return (FLOW_ADD_DUP);
+		flow_unlink(of);
+	}
+	if (flow_count >= (u_int)flow_max)
+		return (FLOW_ADD_FULL);
+
+	SMR_LIST_INSERT_HEAD_LOCKED(b, f, f_hash);
+	flow_count++;
+	return (FLOW_ADD_OK);
+}
+
+/*
+ * Mark f dead and unlink it.  Readers that already hold it see FLOW_DEAD;
+ * the memory goes back to the pool after the next SMR grace period.
+ */
+void
+flow_unlink(struct flow *f)
+{
+	MUTEX_ASSERT_LOCKED(&flow_mtx);
+	KASSERT(flow_count > 0);
+
+	atomic_setbits_int(&f->f_flags, FLOW_DEAD);
+	SMR_LIST_REMOVE_LOCKED(f, f_hash);
+	flow_count--;
+	smr_call(&f->f_smr, flow_free, f);
+}
+
+static void
+flow_free(void *arg)
+{
+	pool_put(&flow_pool, arg);
+}
+
+/* Allocate a zeroed flow for the caller to fill in, or NULL. */
+struct flow *
+flow_alloc(void)
+{
+	return (pool_get(&flow_pool, PR_NOWAIT | PR_ZERO));
+}
+
+/* Free a flow that was never linked. */
+void
+flow_alloc_free(struct flow *f)
+{
+	pool_put(&flow_pool, f);
+}
+
+/*
+ * Mode transition step 5: unlink every flow.  Commits, GC and the worker
+ * are stopped, so nothing inserts meanwhile; flow_mtx is dropped between
+ * buckets to keep IPL_NET hold times short.
+ */
+static void
+flow_flush(void)
+{
+	struct flow *f, *nf;
+	u_int i;
+
+	for (i = 0; i < nitems(flow_tbl); i++) {
+		mtx_enter(&flow_mtx);
+		SMR_LIST_FOREACH_SAFE_LOCKED(f, &flow_tbl[i], f_hash, nf)
+			flow_unlink(f);
+		mtx_leave(&flow_mtx);
+	}
+	KASSERT(flow_count == 0);
+}
+
+/* The MD RX loop ran out of budget (SPEC 6.2 yield). */
+void
+flow_count_yield(void)
+{
+	counters_inc(flow_counters, flowc_yield);
 }
 
