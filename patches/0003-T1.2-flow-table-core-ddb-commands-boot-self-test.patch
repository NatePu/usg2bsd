 	taskq_del_barrier(flow_tq, &flow_learn_t);
 	taskq_del_barrier(flow_tq, &flow_gc_t);
 
-	/* 5. empty the table and the learn ring */
+	/* 5. empty the table and the learn ring; wait out the readers */
+	flow_flush();
+	smr_barrier();
 
 	/* 6. stock RX scheduling for mode 0, bounded for modes 1-3 */
 	if (flow_md != NULL)
@@ -434,6 +589,7 @@ static const char *const flow_counter_names[flowc_ncounters] = {
 	[flowc_gc_stale] =	"gc_stale",
 	[flowc_gc_arp] =	"gc_arp",
 	[flowc_arp_refresh] =	"arp_refresh",
+	[flowc_yield] =		"yield",
 };
 
