+#ifdef DDB
+static void
+db_flow_print_addr(uint32_t a)
+{
+	const uint8_t *p = (const uint8_t *)&a;
+
+	db_printf("%u.%u.%u.%u", p[0], p[1], p[2], p[3]);
+}
+
+static void
+db_flow_print(struct flow *f, int full)
+{
+	unsigned long long pkts = 0, bytes = 0;
+	u_int i;
+
+	for (i = 0; i < FLOW_NCPU; i++) {
+		pkts += f->f_ctr[i].fc_pkts;
+		bytes += f->f_ctr[i].fc_bytes;
+	}
+	db_printf("%p port %u ", f, f->f_key.fk_port);
+	if (f->f_key.fk_vid & FK_TAGGED)
+		db_printf("vid %u ", f->f_key.fk_vid & ~FK_TAGGED);
+	else
+		db_printf("untagged ");
+	db_flow_print_addr(f->f_key.fk_src);
+	db_printf(" > ");
+	db_flow_print_addr(f->f_key.fk_dst);
+	db_printf(" gen %u%s%s if %u>%u nh ", f->f_gen,
+	    f->f_gen == flow_gen ? "" : " stale",
+	    ISSET(f->f_flags, FLOW_DEAD) ? " DEAD" : "",
+	    f->f_in_ifidx, f->f_out_ifidx);
+	db_flow_print_addr(f->f_nexthop.s_addr);
+	db_printf(" mtu %u pkts %llu\n", f->f_mtu, pkts);
+	if (!full)
+		return;
+
+	db_printf("  egress %p rtable %u prio %u txpcp %u bytes %llu\n",
+	    f->f_egress, f->f_rtableid, f->f_prio, f->f_txpcp, bytes);
+	db_printf("  l2 (%u):", f->f_l2len);
+	for (i = 0; i < f->f_l2len && i < sizeof(f->f_l2); i++)
+		db_printf(" %02x", f->f_l2[i]);
+	db_printf("\n  in dmac %02x:%02x:%02x:%02x:%02x:%02x",
+	    f->f_in_dmac[0], f->f_in_dmac[1], f->f_in_dmac[2],
+	    f->f_in_dmac[3], f->f_in_dmac[4], f->f_in_dmac[5]);
+	db_printf(" seen %llu lastact %lld\n",
+	    (unsigned long long)f->f_seen, (long long)f->f_lastact);
+	for (i = 0; i < FLOW_NCPU; i++) {
+		db_printf("  cpu%u pkts %llu bytes %llu\n", i,
+		    (unsigned long long)f->f_ctr[i].fc_pkts,
+		    (unsigned long long)f->f_ctr[i].fc_bytes);
+	}
+}
+
+/* show flows [/count]: global state and the first entries (32 by default) */
+void
+db_show_flows(db_expr_t addr, int have_addr, db_expr_t count, char *modif)
+{
+	struct flow *f;
+	u_int i, n = 0, limit;
+
+	limit = count == -1 ? 32 : count;
+	db_printf("mode %u (requested %u) gen %u flows %u max %d"
+	    " learn-gate %u commit %d gc %d accepting %d\n",
+	    flow_mode, flow_mode_req, flow_gen, flow_count, flow_max,
+	    flow_learn_gate, flow_commit_enabled, flow_gc_enabled,
+	    flow_accepting);
+	for (i = 0; i < nitems(flow_tbl); i++) {
+		SMR_LIST_FOREACH_LOCKED(f, &flow_tbl[i], f_hash) {
+			if (n++ >= limit)
+				return;
+			db_flow_print(f, 0);
+		}
+	}
+}
+
+/* show flow <addr>: one entry in full */
+void
+db_show_flow(db_expr_t addr, int have_addr, db_expr_t count, char *modif)
+{
+	if (!have_addr) {
+		db_printf("usage: show flow <address>\n");
+		return;
+	}
+	db_flow_print((struct flow *)addr, 1);
+}
+#endif /* DDB */
+
+#if defined(DIAGNOSTIC) || defined(FLOW_SELFTEST)
+/* FLOW_SELFTEST builds the self-test alone (tests/flowtable). */
+static struct flow *
+flow_selftest_new(u_int i, u_int gen)
+{
+	struct flow *f;
+
+	f = flow_alloc();
+	if (f == NULL)
+		return (NULL);
+	f->f_key.fk_port = i % 3;
+	f->f_key.fk_vid = (i & 1) ? FK_TAGGED | (1 + i % 4094) : 0;
+	f->f_key.fk_src = htonl(0x0a000000 | i);	/* 10.0.0.0/8 */
+	f->f_key.fk_dst = htonl(0xc6120000 | i);	/* 198.18.0.0/15 */
+	f->f_gen = gen;
+	f->f_l2len = ETHER_HDR_LEN;
+	return (f);
+}
+
+static int
+flow_selftest_find(u_int i, struct flow *expect)
+{
+	struct flow_key k;
+	struct flow *f;
+
+	memset(&k, 0, sizeof(k));
+	k.fk_port = i % 3;
+	k.fk_vid = (i & 1) ? FK_TAGGED | (1 + i % 4094) : 0;
+	k.fk_src = htonl(0x0a000000 | i);
+	k.fk_dst = htonl(0xc6120000 | i);
+	smr_read_enter();
+	f = flow_lookup(&k);
+	smr_read_leave();
+	return (f == expect);
+}
+
+/* Add f; anything the table refuses was never linked and is freed here. */
+static int
+flow_selftest_add(struct flow *f)
+{
+	int r;
+
+	mtx_enter(&flow_mtx);
+	r = flow_table_add(f);
+	mtx_leave(&flow_mtx);
+	if (r != FLOW_ADD_OK)
+		flow_alloc_free(f);
+	return (r);
+}
+
+/*
+ * DIAGNOSTIC boot self-test of the table operations: insert, lookup, an
+ * absent key, duplicate, stale same-key replacement, unlink, full, and 64
+ * keys spread over the buckets.  It runs in flowattach() with every gate
+ * closed, ends by flushing the table and prints one line.  A failure does
+ * not panic, so the kernel still boots for inspection.
+ */
+static void
+flow_selftest(void)
+{
+	struct flow *a, *b, *f, *many[64];
+	const char *fail = NULL;
+	int saved_max = flow_max, r;
+	u_int gen = atomic_load_int(&flow_gen), i, checks = 0;
+
+#define FLOW_ST(cond, what) do {					\
+	checks++;							\
+	if (fail == NULL && !(cond))					\
+		fail = (what);						\
+} while (0)
+
+	if ((a = flow_selftest_new(0, gen)) == NULL)
+		goto nomem;
+	r = flow_selftest_add(a);
+	FLOW_ST(r == FLOW_ADD_OK && flow_count == 1, "insert");
+	FLOW_ST(flow_selftest_find(0, r == FLOW_ADD_OK ? a : NULL), "lookup");
+	FLOW_ST(flow_selftest_find(1, NULL), "absent key");
+
+	if ((f = flow_selftest_new(0, gen)) == NULL)	/* same key and gen */
+		goto nomem;
+	r = flow_selftest_add(f);
+	FLOW_ST(r == FLOW_ADD_DUP && flow_count == 1, "duplicate");
+	FLOW_ST(flow_selftest_find(0, a), "lookup after duplicate");
+
+	if ((b = flow_selftest_new(0, gen + 1)) == NULL) /* newer gen */
+		goto nomem;
+	r = flow_selftest_add(b);			/* unlinks a */
+	FLOW_ST(r == FLOW_ADD_OK && flow_count == 1, "stale replacement");
+	FLOW_ST(flow_selftest_find(0, r == FLOW_ADD_OK ? b : a),
+	    "lookup after replacement");
+	if (r == FLOW_ADD_OK) {
+		mtx_enter(&flow_mtx);
+		flow_unlink(b);
+		mtx_leave(&flow_mtx);
+		FLOW_ST(flow_count == 0 && flow_selftest_find(0, NULL),
+		    "unlink");
+	}
+
+	/* full: with a limit of two the third flow is refused */
+	flow_max = flow_count + 2;
+	for (i = 1; i <= 3; i++) {
+		if ((f = flow_selftest_new(i, gen)) == NULL)
+			goto nomem;
+		r = flow_selftest_add(f);
+		FLOW_ST(r == (i <= 2 ? FLOW_ADD_OK : FLOW_ADD_FULL), "full");
+	}
+	flow_max = saved_max;
+
+	/* 64 more keys over the buckets, every one found */
+	for (i = 0; i < nitems(many); i++) {
+		if ((f = flow_selftest_new(i + 4, gen)) == NULL)
+			goto nomem;
+		many[i] = flow_selftest_add(f) == FLOW_ADD_OK ? f : NULL;
+		FLOW_ST(many[i] != NULL, "insert 64");
+	}
+	for (i = 0; i < nitems(many); i++) {
+		if (many[i] != NULL)
+			FLOW_ST(flow_selftest_find(i + 4, many[i]),
+			    "lookup 64");
+	}
+	FLOW_ST(flow_count == 2 + nitems(many), "count");
+	goto out;
+
+nomem:
+	fail = "allocation";
+out:
+	flow_max = saved_max;
+	flow_flush();
+	FLOW_ST(flow_count == 0, "empty afterwards");
+#undef FLOW_ST
+
+	if (fail == NULL)
+		printf("flow: table self-test passed (%u checks)\n", checks);
+	else
+		printf("flow: table self-test FAILED: %s\n", fail);
+}
+#endif /* DIAGNOSTIC || FLOW_SELFTEST */
