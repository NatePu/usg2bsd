@@ -205,6 +223,9 @@ flowattach(int count)
 
 #if NKSTAT > 0
 	flow_kstat_attach();
+#ifdef DIAGNOSTIC
+	flow_trace_kstat_attach();
+#endif
 #endif
 #if defined(DIAGNOSTIC) || defined(FLOW_SELFTEST)
 	flow_selftest();
@@ -363,12 +384,51 @@ flow_md_register(const struct flow_md_ops *ops)
 void
 flow_gen_bump(enum flow_gen_src src)
 {
+	u_int gen;
+
 	KASSERT(src < FLOW_GEN_NSRC);
 
 	membar_producer();
-	atomic_inc_int(&flow_gen);
+	gen = atomic_inc_int_nv(&flow_gen);
 	if (flow_counters != NULL)
 		counters_inc(flow_counters, flowc_gen_rt + src);
+#ifdef DIAGNOSTIC
+	flow_trace_add(FLOW_TR_BUMP + src, gen, 0);
+#else
+	(void)gen;
+#endif
+}
+
+/*
+ * The learn gate (DESIGN 5.3) is set only while IP forwarding is 1 (2 is
+ * IPsec-only forwarding), no IPsec policy exists, and pf is stopped or
+ * skips at least one interface.  It only lets HOOK B drop requests that no
+ * commit could accept; commits still check every interface.  pfi_xcommit()
+ * passes whether any pf interface has PFI_IFLAG_SKIP, other callers -1.
+ * Callers change their input first; the mutex makes the last caller
+ * compute from the latest inputs, so racing updates cannot leave a stale
+ * gate behind.  Any context.
+ */
+void
+flow_gate_update(int pf_skip_any)
+{
+	u_int gate = 1;
+
+	mtx_enter(&flow_gate_mtx);
+	if (pf_skip_any != -1)
+		flow_pf_skip_any = pf_skip_any != 0;
+	if (atomic_load_int(&ip_forwarding) != 1)
+		gate = 0;
+#ifdef IPSEC
+	if (atomic_load_int(&ipsec_in_use) != 0)
+		gate = 0;
+#endif
+#if NPF > 0
+	if (atomic_load_int(&pf_status.running) && !flow_pf_skip_any)
+		gate = 0;
+#endif
+	atomic_store_int(&flow_learn_gate, gate);
+	mtx_leave(&flow_gate_mtx);
 }
 
 /* net.flow.* (SPEC §6.1).  Process context, no locks held. */
@@ -642,6 +702,47 @@ flow_kstat_attach(void)
 }
 #endif /* NKSTAT > 0 */
 
+#ifdef DIAGNOSTIC
+#define FLOW_TRACE_N		4096	/* power of two */
+
+static struct flow_trace_ent	 flow_trace[FLOW_TRACE_N];
+static u_int			 flow_trace_next;	/* [a] */
+
+/* Any context.  Entries are overwritten in place once the ring wraps. */
+void
+flow_trace_add(u_int kind, u_int gen, uint32_t id)
+{
+	struct flow_trace_ent *e;
+	struct timespec ts;
+	u_int seq;
+
+	seq = atomic_inc_int_nv(&flow_trace_next) - 1;
+	e = &flow_trace[seq & (FLOW_TRACE_N - 1)];
+	nanouptime(&ts);
+	e->fte_nsec = TIMESPEC_TO_NSEC(&ts);
+	e->fte_gen = gen;
+	e->fte_id = id;
+	e->fte_kind = kind;
+	e->fte_cpu = cpu_number();
+	e->fte_seq = seq;
+}
+
+#if NKSTAT > 0
+static void
+flow_trace_kstat_attach(void)
+{
+	struct kstat *ks;
+
+	ks = kstat_create("flow", 0, "trace", 0, KSTAT_T_RAW, 0);
+	if (ks == NULL)
+		return;
+	ks->ks_data = flow_trace;
+	ks->ks_datalen = sizeof(flow_trace);
+	kstat_install(ks);
+}
+#endif
+#endif /* DIAGNOSTIC */
+
 #ifdef DDB
 static void
 db_flow_print_addr(uint32_t a)
@@ -717,6 +818,31 @@ db_show_flows(db_expr_t addr, int have_addr, db_expr_t count, char *modif)
 	}
 }
 
+#ifdef DIAGNOSTIC
+/* show flowtrace [/count]: the last bumps and admissions (32 by default) */
+void
+db_show_flowtrace(db_expr_t addr, int have_addr, db_expr_t count,
+    char *modif)
+{
+	struct flow_trace_ent *e;
+	u_int n, i, next = flow_trace_next;
+
+	n = count == -1 ? 32 : count;
+	if (n > FLOW_TRACE_N)
+		n = FLOW_TRACE_N;
+	if (n > next)
+		n = next;
+	for (i = next - n; i != next; i++) {
+		e = &flow_trace[i & (FLOW_TRACE_N - 1)];
+		db_printf("%u %llu cpu%u %s%u gen %u id %u\n", e->fte_seq,
+		    (unsigned long long)e->fte_nsec, e->fte_cpu,
+		    e->fte_kind == FLOW_TR_ADMIT ? "admit" : "bump src ",
+		    e->fte_kind == FLOW_TR_ADMIT ? 0 : e->fte_kind,
+		    e->fte_gen, e->fte_id);
+	}
+}
+#endif
+
 /* show flow <addr>: one entry in full */
 void
 db_show_flow(db_expr_t addr, int have_addr, db_expr_t count, char *modif)
diff --git a/sys/net/if_flowvar.h b/sys/net/if_flowvar.h
index d6b8fd2c..8f3625ef 100644
--- a/sys/net/if_flowvar.h
+++ b/sys/net/if_flowvar.h
@@ -137,6 +137,30 @@ void		 flow_count_yield(void);
 
 extern struct mutex	flow_mtx;
 
+#ifdef DIAGNOSTIC
+/*
+ * Admission/bump trace (DESIGN 5.4): bumps and admitted hits with the
+ * generation they saw, so tests can check admissions against the bump
+ * boundary without bpf on the router.  ddb "show flowtrace", raw kstat
+ * flow:0:trace.
+ */
+#define FLOW_TR_BUMP		0	/* + enum flow_gen_src */
+#define FLOW_TR_ADMIT		16	/* hit admitted; id from the packet */
+
+struct flow_trace_ent {
+	uint64_t		 fte_nsec;	/* nanouptime() */
+	uint32_t		 fte_gen;	/* new or admitted generation */
+	uint32_t		 fte_id;	/* packet id (admissions) */
+	uint16_t		 fte_kind;	/* FLOW_TR_* */
+	uint16_t		 fte_cpu;
+	uint32_t		 fte_seq;	/* trace sequence number */
+};
+
+void	flow_trace_add(u_int, u_int, uint32_t);
+#define flow_trace_admit(_id, _gen) \
+	flow_trace_add(FLOW_TR_ADMIT, (_gen), (_id))
+#endif /* DIAGNOSTIC */
+
 #endif /* _KERNEL */
 
 #endif /* _NET_IF_FLOWVAR_H_ */
