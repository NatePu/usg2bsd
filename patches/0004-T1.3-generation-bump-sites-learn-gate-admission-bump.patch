@@ -142,6 +153,10 @@ static struct rwlock	 flow_ctl_lock = RWLOCK_INITIALIZER("flowctl");
 struct mutex		 flow_mtx = MUTEX_INITIALIZER(IPL_NET);
 struct mutex		 flow_ring_mtx = MUTEX_INITIALIZER(IPL_NET);
 
+/* leaf lock: the learn gate is recomputed from all inputs as one step */
+static struct mutex	 flow_gate_mtx = MUTEX_INITIALIZER(IPL_NET);
+static int		 flow_pf_skip_any;		/* [G] last pfi_xcommit() */
+
 static int		 flow_commit_enabled;		/* [F] */
 static int		 flow_gc_enabled;		/* [F] */
 static int		 flow_accepting;		/* [R] */
@@ -174,6 +189,9 @@ static void		 flow_selftest(void);
 
 #if NKSTAT > 0
