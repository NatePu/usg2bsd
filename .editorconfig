# EditorConfig (https://editorconfig.org): most editors apply this on save.
# The coding rules behind it are in AGENTS.md.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C, shell, awk, yacc, lex and make: OpenBSD style(9), hard tabs 8 wide.
[{*.c,*.h,*.sh,*.awk,*.y,*.l,*.mk,Makefile,Makefile.*}]
indent_style = tab
indent_size = tab
tab_width = 8

# Python: PEP 8.
[*.py]
indent_style = space
indent_size = 4

# GitHub Actions workflows.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# The patch series is generated by tools/fork-patches.sh: never rewrite it.
[patches/*.patch]
charset = unset
end_of_line = unset
indent_style = unset
insert_final_newline = unset
trim_trailing_whitespace = false

# The OpenBSD tree made by tools/fork-src.sh: new code follows style(9),
# but upstream lines a change does not need stay byte for byte.
[src/**]
insert_final_newline = unset
trim_trailing_whitespace = false
